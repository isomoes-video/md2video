{
  "name": "md2video",
  "version": "0.1.5",
  "description": "Source-to-video pipeline: animated Remotion scenes, per-slide TTS narration, subtitles, intro and thumbnail",
  "scripts": {
    "video": "node scripts/render_video.mjs",
    "preview": "node scripts/render_video.mjs --preview",
    "test:video": "node --test tests/test_video_data.mjs",
    "typecheck": "tsc --noEmit"
  },
  "author": "isomoes",
  "repository": {
    "type": "git",
    "url": "https://github.com/isomoes-video/md2video.git"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
